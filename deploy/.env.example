# Copy to .env and adjust:  cp .env.example .env
#
# Unlike the dev setup, the three paths below are REQUIRED and should be
# absolute -- on a server you want the music on the big disk, not inside this
# folder. Compose will refuse to start if they are unset.

# ---- Storage (required, absolute paths) ----

# Where finished music is written (one subfolder per playlist CSV).
MUSIC_PATH=/srv/playlist-downloader/music

# Where playlist CSVs live; uploads land here too.
PLAYLIST_PATH=/srv/playlist-downloader/playlists

# Persisted yt-dlp upgrades and the saved Spotify token. Small, but keep it --
# losing it means re-doing the Spotify connect.
STATE_PATH=/srv/playlist-downloader/state

# ---- Image ----

# Pin a version tag for reproducible deploys and easy rollback; `latest` always
# takes whatever was pushed last.
IMAGE=ghcr.io/roncanfil/spotify-playlists-to-mp3
IMAGE_TAG=latest

# ---- Server ----

# Host port the UI listens on. The redirect URI below follows this
# automatically, but the Spotify dashboard entry does NOT -- see below.
PORT=8765

# Leave blank for no login. Any username works; only the password is checked.
# Set this if the port is reachable from anywhere but your own LAN.
APP_PASSWORD=

# Re-install the latest yt-dlp on each container start (1) or pin the image's
# bundled version (0). Leave at 1: a restart is then the fix for most YouTube
# breakage, with no image rebuild.
AUTO_UPDATE_YTDLP=1

# ---- Spotify (optional; enables the Playlists tab) ----
# Create a free app at https://developer.spotify.com/dashboard, tick "Web API",
# and register the redirect URI below EXACTLY. Then paste the Client ID here.
# No client secret is needed: the app uses Authorization Code + PKCE.
# Leave blank to skip Spotify entirely and just upload CSVs.
SPOTIFY_CLIENT_ID=

# Leave this commented out unless you changed PORT above -- it defaults to
# http://127.0.0.1:${PORT}/callback, which is already correct.
#
# Spotify refuses `localhost` and requires HTTPS for anything that is not a
# loopback address, so this must stay on 127.0.0.1. That means the one-time
# "Connect to Spotify" click has to come from a browser that reaches the server
# as 127.0.0.1 -- easiest via an SSH tunnel:
#
#   ssh -L 8765:127.0.0.1:8765 you@server
#   # then open http://127.0.0.1:8765 locally and click Connect
#
# Afterwards the token lives in STATE_PATH and every user shares it.
#
# Whatever this ends up being, paste it into the Spotify dashboard's redirect
# URI list EXACTLY, including the port.
#SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
