# Copy to .env and adjust. Relative paths resolve against web-ui/.

# Port the UI listens on.
PORT=8765

# Where finished music is written (one subfolder per playlist CSV).
MUSIC_PATH=./data/music

# Where playlist CSVs live; uploads land here too.
PLAYLIST_PATH=./data/playlists

# Persisted yt-dlp upgrades, so they survive image rebuilds.
STATE_PATH=./data/state

# Leave blank for no login. Any username works; only the password is checked.
APP_PASSWORD=

# Re-install the latest yt-dlp on each container start (1) or pin the image's
# bundled version (0).
AUTO_UPDATE_YTDLP=1

# ---- Spotify (optional; enables the Playlists tab) ----
# Create a free app at https://developer.spotify.com/dashboard, tick "Web API",
# and register the redirect URI below EXACTLY. Then paste the Client ID here.
# No client secret is needed: the app uses Authorization Code + PKCE.
SPOTIFY_CLIENT_ID=

# Leave this commented out unless you changed PORT above -- it defaults to
# http://127.0.0.1:${PORT}/callback, which is already correct.
#
# Spotify refuses `localhost` and requires HTTPS for anything that is not a
# loopback address, so this must stay on 127.0.0.1 -- which means the one-time
# "Connect to Spotify" step has to be done from a browser on the server itself
# (or through `ssh -L`, see the README). Afterwards the token is stored in
# STATE_PATH and everyone can use it.
#
# Whatever this ends up being, paste it into the Spotify dashboard's redirect
# URI list EXACTLY, including the port.
#SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
